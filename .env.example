# Nebius Token Factory — https://tokenfactory.nebius.com
# Create an API key, then copy this file:  cp .env.example .env
# .env is git-ignored. Never commit a real key.
NEBIUS_API_KEY=

# Optional. Leave commented out to use the defaults.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# Nemotron 3 is a thinking model. The app asks for thinking to be off, but if an
# answer still reads like the model planning out loud, point NEBIUS_MODEL at
# another nvidia/ model from https://tokenfactory.nebius.com and restart.
